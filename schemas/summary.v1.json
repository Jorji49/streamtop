{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jorji49/streamtop/schemas/summary.v1.json",
  "title": "streamtop.summary.v1",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "verdict",
    "ok",
    "health_score",
    "health_label",
    "status",
    "latency",
    "cdn",
    "origin_stalls",
    "critical_rfc_errors",
    "url",
    "errors",
    "saw_segment"
  ],
  "properties": {
    "schema": { "const": "streamtop.summary.v1" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "verdict": { "enum": ["PASS", "FAIL"] },
    "ok": { "type": "boolean" },
    "health_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "health_label": { "type": "string" },
    "status": { "enum": ["LIVE", "DEGRADED", "ERROR"] },
    "latency": { "type": "string" },
    "cdn": { "type": "string" },
    "ttfb_ms": { "type": ["integer", "null"], "minimum": 0 },
    "last_http_status": { "type": ["integer", "null"] },
    "origin_stalls": { "type": "integer", "minimum": 0 },
    "critical_rfc_errors": { "type": "integer", "minimum": 0 },
    "url": { "type": "string" },
    "errors": { "type": "integer", "minimum": 0 },
    "saw_segment": { "type": "boolean" },
    "dropped_events": { "type": "integer", "minimum": 0 },
    "g2g_total_ms": { "type": ["integer", "null"] },
    "virtual_buffer_secs": { "type": ["number", "null"] },
    "rebuffer_probability_pct": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "subtitle_drift_ms": { "type": ["integer", "null"] },
    "pssh_systems": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "tr101290": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "p1_violations": { "type": "integer", "minimum": 0 },
        "p2_violations": { "type": "integer", "minimum": 0 },
        "sync_errors": { "type": "integer", "minimum": 0 },
        "cc_errors": { "type": "integer", "minimum": 0 },
        "pat_timeout": { "type": "boolean" },
        "pmt_timeout": { "type": "boolean" },
        "pcr_gap_ms": { "type": ["number", "null"] },
        "pcr_jitter_ms": { "type": ["number", "null"] },
        "pts_discontinuities": { "type": "integer", "minimum": 0 },
        "unreferenced_pids": { "type": "integer", "minimum": 0 }
      }
    },
    "synthetic_qoe": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "tdr": { "type": "number" },
        "rebuffer_risk_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "ttff_ms": { "type": ["integer", "null"], "minimum": 0 },
        "selected_bitrate_bps": { "type": ["integer", "null"], "minimum": 0 },
        "buffer_2s_rebuffer_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
        "buffer_4s_rebuffer_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
        "buffer_6s_rebuffer_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
        "throttle_kbps": { "type": ["integer", "null"], "minimum": 0 },
        "simulated_rtt_ms": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "sei_metadata": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "cea608_present": { "type": "boolean" },
        "cea708_present": { "type": "boolean" },
        "hdr10_present": { "type": "boolean" },
        "hlg_present": { "type": "boolean" },
        "max_cll": { "type": ["integer", "null"], "minimum": 0 },
        "max_fall": { "type": ["integer", "null"], "minimum": 0 },
        "caption_language": { "type": ["string", "null"] },
        "nal_units_scanned": { "type": "integer", "minimum": 0 }
      }
    },
    "ingest_stats": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "type": "string" },
        "rtt_ms": { "type": ["integer", "null"], "minimum": 0 },
        "packet_loss_pct": { "type": ["number", "null"] },
        "nak_count": { "type": ["integer", "null"], "minimum": 0 },
        "flight_buffer_depth": { "type": ["integer", "null"], "minimum": 0 },
        "bandwidth_mbps": { "type": ["number", "null"] },
        "video_codec": { "type": ["string", "null"] },
        "audio_codec": { "type": ["string", "null"] },
        "keyframe_interval_ms": { "type": ["integer", "null"], "minimum": 0 },
        "connected": { "type": ["boolean", "null"] }
      }
    }
  },
  "additionalProperties": false
}
